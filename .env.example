# Copy to .env and adjust. No secrets are needed for any MVP data source.
# Postgres connection used by scripts/ and api/ (matches docker-compose.yml).
DATABASE_URL=postgresql://isthmus:isthmus@localhost:5432/isthmus
# Census API base. NOTE: api.census.gov now requires a free key; if
# CENSUS_API_KEY is unset, ingest_census.py falls back to Census Reporter,
# which republishes the same ACS 5-year tables without a key.
CENSUS_API_BASE=https://api.census.gov/data
CENSUS_API_KEY=
# Overpass API endpoint for OpenStreetMap POIs.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Madison Metro GTFS static feed.
GTFS_URL=https://transitdata.cityofmadison.com/GTFS/mmt_gtfs.zip
# Frontend -> API base URL (browser-visible).
NEXT_PUBLIC_API_URL=http://localhost:8000
